# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production

# HashiCorp Vault Configuration
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your_vault_root_token_here
VAULT_NAMESPACE=

# Cache Configuration (in seconds)
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Rotation Configuration (in seconds)
ROTATION_INTERVAL=1800
GRACE_PERIOD=600

# Services to Auto-Rotate
# Comma-separated list of service names
SERVICES_TO_ROTATE=github,slack,stripe,api_service

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security Configuration
SECRET_KEY=your_secret_key_here_change_in_production
JWT_SECRET=your_jwt_secret_here_change_in_production

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2

# Vault KV Secrets Engine Path
VAULT_KV_PATH=secret

# Health Check Configuration
HEALTH_CHECK_INTERVAL=60
VAULT_HEALTH_CHECK_TIMEOUT=10

# API Rate Limiting (optional)
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Slack/Alert Configuration (for notifications on rotation failures)
ALERT_SLACK_WEBHOOK=
ALERT_EMAIL=admin@example.com

# Database Configuration (if needed for audit logging)
DATABASE_URL=sqlite:///vault_audit.db

# APScheduler Configuration
SCHEDULER_TIMEZONE=UTC
SCHEDULER_JOB_DEFAULTS_COALESCE=True
SCHEDULER_JOB_DEFAULTS_MAX_INSTANCES=1

# Development/Testing
TESTING=False
MOCK_VAULT=False
